{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riskpulse.local/contracts/scenario.v1.schema.json",
  "title": "Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "name", "trigger", "shocks"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "min_impact", "min_confidence"],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "min_impact": { "type": "number", "minimum": 1, "maximum": 10 },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "shocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equity_pct", "rate_bp", "credit_spread_bp", "fx_pct"],
      "properties": {
        "equity_pct": { "type": "number" },
        "rate_bp": { "type": "number" },
        "credit_spread_bp": { "type": "number" },
        "fx_pct": { "type": "number" }
      }
    }
  }
}
