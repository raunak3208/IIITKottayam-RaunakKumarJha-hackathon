# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=riskpulse
POSTGRES_PASSWORD=riskpulse
POSTGRES_DB=riskpulse

# ── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_URL is injected by docker-compose; leave blank here

# ── LLM (Mistral) ─────────────────────────────────────────────────────────────
LLM_PROVIDER=mistral
LLM_API_KEY=
LLM_MODEL=mistral-small-latest

# ── ARIA Research Agent ───────────────────────────────────────────────────────
TAVILY_API_KEY=
# ── Reddit Ingestion (optional) ───────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=